{
   "name": "bmad-method",
   "build": {
      "dockerfile": "Dockerfile"
   },
   "remoteUser": "vscode",
   "remoteEnv": {
      "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
   },
   "postCreateCommand": "npx --yes bmad-method@6.10.0 install --directory . --yes --modules bmm,bmb,cis --tools claude-code",
   "customizations": {
      "vscode": {
         "extensions": [
            "anthropic.claude-code",
            "swiftlang.swift-vscode"
         ]
      }
   }
}