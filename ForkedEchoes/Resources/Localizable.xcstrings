    "home.storySubtitle" : {
      "comment" : "Home screen: short one-line subtitle beneath the story title, describes the story (placeholder until Epic 4 authors the real copy)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A choose-your-own-adventure about finding your way back, one decision at a time."
          }
        }
      }
    },
    "home.storyTitle" : {
      "comment" : "Home screen: large headline, the in-fiction story's title (placeholder until Epic 4 authors the real title)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untitled Story"
          }
        }
      }
    },
    "story.firstChoice.body" : {
      "comment" : "Story 2.1 placeholder content tree: firstChoice node's prompt text, shown above the two choice options",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dock splits two ways. One path leads back toward the boat you arrived on. The other cuts along the shoreline, away from it."
          }
        }
      }
    },
    "story.firstChoice.choice.1" : {
      "comment" : "Story 2.1 placeholder content tree: firstChoice node's first option label, leads to the endingHomeward placeholder",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go back to the boat."
          }
        }
      }
    },
    "story.firstChoice.choice.2" : {
      "comment" : "Story 2.1 placeholder content tree: firstChoice node's second option label, leads to the endingElsewhere placeholder",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow the shoreline instead."
          }
        }
      }
    },
    "story.intro.body" : {
      "comment" : "Story 2.1 placeholder content tree: intro reading node's body text, the story's opening page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You make one choice too many, and suddenly you're not home anymore."
          }
        }
      }
    },
    "storyChoice.action.exitToHome" : {
      "comment" : "Story/Choice screen: temporary interim exit control (code review, 2026-08-01) — the .fullScreenCover Story session has no system back button or swipe-to-dismiss, and nothing else in the app can dismiss it yet. Replace with Story 2.7's real run-options sheet / Memory's \"Return Home\" when either lands.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exit to Home"
          }
        }
      }
    },
    "storyChoice.pager.nextPage" : {
      "comment" : "Story/Choice screen: VoiceOver custom rotor action, advances to the next page (same effect as swiping left or tapping the right third)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next Page"
          }
        }
      }
    },
    "storyChoice.pager.previousPage" : {
