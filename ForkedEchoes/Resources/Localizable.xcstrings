          "stringUnit" : {
            "state" : "translated",
            "value" : "Untitled Story"
          }
        }
      }
    },
    "story.boatEcho.body" : {
      "comment" : "Story 2.5 echo-wired content tree: boatEcho node's ordinary body text, reached only via firstChoice's boat option",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The oars are cold, but they fit your hands the way they did before."
          }
        }
      }
    },
    "story.boatEcho.echo" : {
      "comment" : "Story 2.5 echo-wired content tree: boatEcho node's Echo callback prose, explicitly naming the earlier boat choice — rendered inline within the node's body inside the \"The story remembers\" callback block",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You chose the boat back at the dock. It's waiting for you now, exactly where you left it."
          }
        }
      }
    },
    "story.firstChoice.body" : {
      "comment" : "Story 2.1 placeholder content tree: firstChoice node's prompt text, shown above the two choice options",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dock splits two ways. One path leads back toward the boat you arrived on. The other cuts along the shoreline, away from it."
          }
        }
      }
    },
    "story.firstChoice.choice.1" : {
      "comment" : "Story 2.1 placeholder content tree: firstChoice node's first option label, leads to the endingHomeward placeholder",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go back to the boat."
          }
        }
      }
    },
    "story.firstChoice.choice.2" : {
      "comment" : "Story 2.1 placeholder content tree: firstChoice node's second option label, leads to the endingElsewhere placeholder",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow the shoreline instead."
          }
        }
      }
    },
    "story.intro.body" : {
      "comment" : "Story 2.1 placeholder content tree: intro reading node's body text, the story's opening page",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You make one choice too many, and suddenly you're not home anymore."
          }
        }
      }
    },
    "story.shoreArrival.body" : {
      "comment" : "Story 2.6: shoreArrival reading node's ordinary body prose, shown after the branch-arrival interstitial is dismissed via Continue.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shore is quieter than you expected, and nothing here looks like the place you left."
          }
        }
      }
    },
    "story.shoreArrival.caption" : {
      "comment" : "Story 2.6: branch-arrival interstitial's flavor caption for the shoreArrival node (UX-DR6) — distinct from the node's ordinary body prose, evokes the new branch reality.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new shore. A new reality."
          }
        }
      }
    },
    "story.shoreArrival.illustration.accessibilityLabel" : {
      "comment" : "Story 2.6: VoiceOver accessibility label for the shoreArrival branch-illustration (EXPERIENCE.md Accessibility Floor) — describes the illustration's specific visual content, not a restatement of the interstitial's caption.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illustration of a fog-lit shoreline at dusk, waves lapping against unfamiliar rocks."
          }
        }
      }
    },
    "storyChoice.choiceCard.hint.tapOrHold" : {
      "comment" : "Choice card accessibility hint (Story 2.3): read by VoiceOver alongside the card label, describing the two commit paths since VoiceOver users only get the double-tap/activate path, not the visual press-and-hold charge animation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double tap to select. A short grace period follows before your choice locks in."
          }
        }
      }
    },
    "storyChoice.choiceCard.hint.undoWindow" : {
      "comment" : "Choice card accessibility hint (Story 2.3): read while the card is in its post-tap undo window, telling VoiceOver users a second activation cancels (mirrors the visual checkmark/fill state sighted users see during this window).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activate again to cancel this choice."
          }
        }
      }
    },
    "storyChoice.echo.tag" : {
      "comment" : "Story 2.5: shared tag label prefacing every Echo callback block (UX-DR5, FR-6) — the same phrase Tutorial's tutorial.mechanic.echo already previews.",
